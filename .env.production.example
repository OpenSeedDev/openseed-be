# IP로 먼저 확인할 때는 :80, DNS 연결 뒤에는 api.example.com 형태로 변경합니다.
SITE_ADDRESS=:80
IMAGE_TAG=latest

DB_NAME=seedrank
DB_USERNAME=seedrank
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# HTTPS 도메인을 연결한 운영 환경에서는 true를 사용합니다.
AUTH_COOKIE_SECURE=false
COMPANY_VERIFICATION_CONFIRM_URL=http://replace-with-frontend-host/company-verification/confirm

# 회사 인증 메일을 사용하기 전에 실제 SMTP 값으로 교체합니다.
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
